{
	"name": "dsh-plugin-subagent-menu",
	"description": "Right-Sidebar tab that watches the current session's subagents: live tree, activity, stats, and click-through into each subagent chat",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-session",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"dsh-plugin-thread-bus"
			]
		}
	},
	"license": "MIT"
}
